PORT=8787
# Producer dashboard password (if empty, one is generated and printed at first start)
CONTROLLER_PASSWORD=change-me
# Tournament admins (bracket/results only)
ADMIN_PASSWORD=change-me-too
# Optional: require ?key=… on /output/* URLs
OUTPUT_KEY=
# Set to 1 when served over HTTPS (required for remote cameras outside localhost)
SECURE_COOKIES=0
# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# coturn static-auth-secret (preferred: per-client 12h credentials)
TURN_SECRET=
# or static TURN credentials
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional OBS WebSocket v5 (credentials stay server-side)
OBS_WS_URL=
OBS_WS_PASSWORD=
