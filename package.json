{
  "name": "overdrive-caster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Overdrive — web broadcast caster system",
  "scripts": {
    "dev": "node scripts/embed-plugin.mjs && concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm install --include=dev --no-audit --no-fund && node scripts/embed-plugin.mjs && tsc -p tsconfig.json --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
