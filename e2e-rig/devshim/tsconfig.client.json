    "esModuleInterop": true, "resolveJsonModule": true, "jsx": "react-jsx", "jsxImportSource": "react",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"], "typeRoots": ["/opt/npm-tools/node_modules/@types"],
    "paths": { "motion/react": ["./motion-react.tsx"], "react-router-dom": ["./react-router-dom.tsx"], "qrcode": ["./qrcode.ts"] }
